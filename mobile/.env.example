# Hallyu mobile — environment template.
# Copy to .env and fill in when the backend exists. Until then the app
# runs adapter-first with honest "backend not linked" states.
# Never commit real secrets. Service-role keys must NEVER enter this bundle.

# Supabase (planned; not yet linked)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# TMDB (planned; used only by the seed-import script, never the bundle)
TMDB_API_KEY=

# Feature flags (all MVP-scope; deferred features stay off)
EXPO_PUBLIC_ENABLE_VIDEO=false
EXPO_PUBLIC_ENABLE_POLLS=false
EXPO_PUBLIC_ENABLE_DMS=false
